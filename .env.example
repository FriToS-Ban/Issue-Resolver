# .env — copy to .env in the directory you run fix-issue from, then uncomment what you need.
#
# How fix-issue reads it (fix_issue/config.py):
#   - only the .env in the CURRENT WORKING DIRECTORY is loaded;
#   - a value here never replaces a variable already set in your real environment;
#   - a variable that is set, even to an empty value, overrides ~/.fix-issue.toml, --config and
#     benchmark/bench.toml. Keep lines you don't use commented out.
#
# Variables whose names look secret (*TOKEN*, *API_KEY*, *_KEY, *SECRET*, ...) are removed from the
# environment before the target repository's tests and linters run.
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# LLM keys
# ---------------------------------------------------------------------------

# NVIDIA NIM key. Used as the [llm] api_key automatically when the [llm] base_url contains
# "nvidia.com" (e.g. https://integrate.api.nvidia.com/v1) and LLM_API_KEY is not set at all.
# The critic and API embeddings fall back to the [llm] key, so this one key covers all three.
# benchmark/bench.toml is set up for this.
# NVIDIA_API_KEY=nvapi-...

# Key for any provider (Anthropic, OpenAI, Gemini, Ollama, NIM, ...). Overrides [llm] api_key.
# If it is set, even to an empty value, NVIDIA_API_KEY is ignored.
# LLM_API_KEY=

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------

# Personal access token with read/write access to contents, issues and pull requests.
# Needed for `fix-issue owner/repo N`; not needed for `fix-issue bench ...`.
# GITHUB_TOKEN=ghp_...

# ---------------------------------------------------------------------------
# Optional overrides of the TOML config
# ---------------------------------------------------------------------------

# [llm] provider: anthropic | openai_compatible | gemini
# LLM_PROVIDER=openai_compatible

# [llm] base_url (required for openai_compatible). Examples:
#   NVIDIA NIM: https://integrate.api.nvidia.com/v1
#   OpenAI:     https://api.openai.com/v1
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# [llm] model. Working on NIM: nvidia/nemotron-3-ultra-550b-a55b.
# deepseek-ai/deepseek-v4.1-flash is end-of-life on NIM and no longer works.
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# [limits] max_diff_lines and max_retries
# FIX_ISSUE_MAX_DIFF_LINES=150
# FIX_ISSUE_MAX_RETRIES=3

# [pipeline] profile: full | baseline
# FIX_ISSUE_PROFILE=full

# [retrieval] embedding_backend: local | openai_compatible | none
# FIX_ISSUE_EMBEDDING_BACKEND=local

# ---------------------------------------------------------------------------
# Data directory
# ---------------------------------------------------------------------------

# Root for run records (runs/) and the embedding cache (cache/). Default: ~/.fix-issue
# Set this in your shell, not here: `fix-issue runs ...` and `fix-issue rerun` look up run
# records before (or without) loading .env.
# FIX_ISSUE_HOME=

# ---------------------------------------------------------------------------
# Environment for repository code
# ---------------------------------------------------------------------------

# Tests and linters of the target repository run with an ALLOWLISTED environment (PATH, temp
# and home directories, locale, Python/Node toolchain variables ...). Everything else — API
# keys, tokens, DATABASE_URL, SSH_AUTH_SOCK — is withheld. If the repository's test suite needs
# extra variables, name them here (comma or space separated). Their values are then visible to
# code from the repository and to code the model wrote.
# FIX_ISSUE_ENV_PASSTHROUGH=DATABASE_URL,REDIS_URL

# Only FIX_ISSUE_*, LLM_*, NVIDIA_API_KEY and GITHUB_TOKEN are read from this file; anything
# else in it is ignored.
