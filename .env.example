# LLM provider to use: anthropic | openai_compatible | gemini
LLM_PROVIDER=anthropic

# API key for the selected provider
LLM_API_KEY=sk-ant-...

# Base URL — only required when LLM_PROVIDER=openai_compatible
# Examples:
#   OpenAI:      https://api.openai.com/v1  (default if blank)
#   Ollama:      http://localhost:11434/v1
#   NVIDIA NIM:  https://integrate.api.nvidia.com/v1
#   LM Studio:   http://localhost:1234/v1
LLM_BASE_URL=

# Model name (must match the selected provider's model IDs)
LLM_MODEL=claude-opus-4-5
# LLM_MODEL=gpt-4o                 # for openai_compatible
# LLM_MODEL=gemini-2.5-pro         # for gemini

# GitHub personal access token (needs repo read + write + PR create)
GITHUB_TOKEN=ghp_...

# Optional overrides (defaults are in ~/.fix-issue.toml)
# FIX_ISSUE_MAX_DIFF_LINES=150
# FIX_ISSUE_MAX_RETRIES=3
